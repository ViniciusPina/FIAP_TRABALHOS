# Limpa skills (remove espaços extras e quebra por virgula)
u_skills_raw <- unlist(strsplit(tolower(usuario$HABILIDADES), "[,;]"))
# --- 2. LEITURA ---
usuarios   <- dbGetQuery(con, "SELECT ID_USUARIO, AREA_INTERESSE, NIVEL_FORMACAO, HABILIDADES FROM USUARIO")
cursos     <- dbGetQuery(con, "SELECT ID_CURSO, NOME, CATEGORIA, NIVEL FROM CURSO")
inscricoes <- dbGetQuery(con, "SELECT ID_USUARIO, ID_CURSO FROM INSCRICAO")
if (nrow(usuarios) == 0 || nrow(cursos) == 0) {
cat("⚠️ Sem dados suficientes.\n")
} else {
# --- 3. LÓGICA SNIPER ---
calcular_score_sniper <- function(usuario, cursos_df) {
u_area <- tolower(usuario$AREA_INTERESSE)
# Limpa skills (remove espaços extras e quebra por virgula)
u_skills_raw <- unlist(strsplit(tolower(usuario$HABILIDADES), "[,;]"))
u_skills <- trimws(u_skills_raw)
u_skills <- u_skills[u_skills != ""] # Remove vazios
scores <- numeric(nrow(cursos_df))
for(i in 1:nrow(cursos_df)) {
c_cat <- tolower(cursos_df$CATEGORIA[i])
c_nome <- tolower(cursos_df$NOME[i])
# 1. Match de Área (Base: 0.30)
match_area <- ifelse(grepl(u_area, c_cat, fixed = TRUE), 0.30, 0.0)
# 2. Match de Palavra-Chave no NOME do curso (Peso: 0.50 - MUITO ALTO)
# Se o usuário digitou "Java" e o curso tem "Java", BOOM! Score alto.
match_keyword <- 0
for(skill in u_skills) {
if(grepl(skill, c_nome, fixed = TRUE)) {
match_keyword <- 0.50 # Encontrou palavra-chave forte
break # Já achou, não precisa somar mais para não estourar
}
}
# 3. Match de Nível (Peso: 0.10)
match_nivel <- ifelse(tolower(usuario$NIVEL_FORMACAO) == tolower(cursos_df$NIVEL[i]), 0.10, 0.0)
# 4. Bônus de Base (Peso: 0.05) - Para ninguém ficar com zero
bonus <- 0.05
# --- CÁLCULO FINAL ---
nota <- match_area + match_keyword + match_nivel + bonus
# Arredonda para parecer porcentagem humana (ex: 0.95, 0.40)
scores[i] <- min(round(nota, 2), 0.99)
}
return(scores)
}
# --- 4. EXECUÇÃO ---
dbExecute(con, "DELETE FROM RECOMENDACAO")
total_gravado <- 0
for (i in seq_len(nrow(usuarios))) {
u <- usuarios[i, ]
# Calcula
scores_calculados <- calcular_score_sniper(u, cursos)
# Remove já feitos
cursos_feitos <- subset(inscricoes, ID_USUARIO == u$ID_USUARIO)$ID_CURSO
temp_df <- data.frame(ID_CURSO = cursos$ID_CURSO, SCORE = scores_calculados)
temp_df <- temp_df[!temp_df$ID_CURSO %in% cursos_feitos, ]
# Ordena e Pega TOP 5
temp_df <- temp_df[order(-temp_df$SCORE), ]
top_recs <- head(temp_df, 5)
if (nrow(top_recs) > 0) {
for (j in seq_len(nrow(top_recs))) {
row <- top_recs[j, ]
# Rótulos inteligentes
tipo <- "Exploração"
if (row$SCORE >= 0.85) tipo <- "🎯 Match Perfeito"
else if (row$SCORE >= 0.60) tipo <- "📈 Alta Aderência"
else if (row$SCORE >= 0.35) tipo <- "💡 Recomendado"
dbExecute(con,
"INSERT INTO RECOMENDACAO (ID_RECOMENDACAO, ID_USUARIO, ID_CURSO, SCORE, TIPO_RECOMENDACAO) VALUES (SEQ_RECOMENDACAO.NEXTVAL, ?, ?, ?, ?)",
params = list(u$ID_USUARIO, row$ID_CURSO, row$SCORE, tipo)
)
total_gravado <- total_gravado + 1
}
}
}
cat(sprintf("✅ Sucesso! %d recomendações geradas.\n", total_gravado))
}
dbDisconnect(con)
source("C:/Users/alexa/Desktop/reskill_full_stack_main_fixedv2/reskill_full_stack_main_fixedv2/reskill_full_stack/backend/analysis/recommender_reskill.R", echo = TRUE)
