# Copie para .env (o .env NAO e versionado):  cp .env.example .env
# Valores de LABORATORIO - troque a senha antes de qualquer uso real.

APP_VERSION=dev

# Credenciais do operador do PDV (HTTP Basic no carrinho-service).
# A senha e entregue ao container como Docker secret (/run/secrets/operador_senha),
# nunca como variavel de ambiente do processo.
OPERADOR_USUARIO=operador
OPERADOR_SENHA=Agnello@Lab2026

# Portas publicadas no host (somente o gateway e exposto)
GATEWAY_HTTPS_PORTA=8443
GATEWAY_HTTP_PORTA=8880
GATEWAY_INSEGURO_PORTA=8881
